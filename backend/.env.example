# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (M0 free tier)
# Get this from Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/philippine_recipe_app?retryWrites=true&w=majority

# Server port (Render/Vercel will usually override this)
PORT=5000

# Filled in during later phases:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
