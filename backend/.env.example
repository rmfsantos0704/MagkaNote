# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (M0 free tier)
# Get this from Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.loiniio.mongodb.net/?appName=Cluster0

# Server port (Render/Vercel will usually override this)
PORT=5000

# Filled in during later phases:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
